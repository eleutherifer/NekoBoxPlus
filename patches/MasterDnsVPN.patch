+	n, _, err := listener.ReadFromUDP(buf)
+	if err != nil {
+		t.Fatalf("listener read: %v", err)
+	}
+	if string(buf[:n]) != "ping" {
+		t.Errorf("payload = %q, want ping", buf[:n])
+	}
