+@OptIn(ExperimentalMaterial3Api::class)
+@Composable
+fun ServiceSettingsScreen(navController: NavController, serviceConnection: ServiceConnection? = null) {
+    OverrideTopBar {
+        TopAppBar(
+            title = { Text(stringResource(R.string.service)) },
+            navigationIcon = {
