+		getHTTPClient: func() (DialerClient, *XmuxClient, error) {
+			switch uploadGets.Add(1) {
+			case 1:
+				return initialClient, initialXmux, nil
+			case 2:
+				return rotatedClient, rotatedXmux, nil
+			default:
