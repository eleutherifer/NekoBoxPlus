+                                    found[packageCache.packageName] = packageCache
+                                }
+                                val nextValue = progressInt.incrementAndGet()
+                                withContext(Dispatchers.Main) {
+                                    scanProgress = ScanProgress(nextValue, scanPackages.size)
+                                }
+                            }
