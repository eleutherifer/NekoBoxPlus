+
+public func dateFromTimestamp(_ timestamp: Int64) -> Date {
+    if timestamp > 100_000_000_000 {
+        return Date(timeIntervalSince1970: Double(timestamp) / 1000)
+    } else {
+        return Date(timeIntervalSince1970: Double(timestamp))
+    }
+}
