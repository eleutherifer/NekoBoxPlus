+                            val appInfo = packageInfo.applicationInfo ?: return@mapNotNull null
+                            PackageCache(packageInfo, appInfo, packageManager)
+                        }
+                    val selectedPackageNames = Settings.perAppProxyList.toMutableSet()
+                    val selectedUidSet =
