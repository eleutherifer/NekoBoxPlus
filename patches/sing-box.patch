+                switch self {
+                case .app:
+                    AppView()
+                case .core:
+                    CoreView()
+                case .packetTunnel:
+                    PacketTunnelView()
+                case .onDemandRules:
+                    OnDemandRulesView()
+                case .profileOverride:
