+
+    #if os(macOS)
+        @MainActor
+        private static func destinationView(for page: SettingsPage) -> some View {
+            Group {
+                switch page {
+                case .app:
+                    AppView()
+                case .core:
+                    CoreView()
+                case .packetTunnel:
+                    PacketTunnelView()
+                case .onDemandRules:
+                    OnDemandRulesView()
+                case .profileOverride:
+                    ProfileOverrideView()
+                case .sponsors:
+                    SponsorsView()
+                }
+            }
+            .frame(maxWidth: .infinity, maxHeight: .infinity, alignment: .center)
