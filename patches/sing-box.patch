+	pooledConn := pool.Get()
+	if pooledConn == nil {
+		t.Fatal("upload connection was not returned to the pool")
+	}
+	if pooledConn.UnreadedResponsesCount != 1 {
+		t.Fatalf("unread response count = %d", pooledConn.UnreadedResponsesCount)
