+
+func TestParseClientEncryptionShortPaddingBeforeKey(t *testing.T) {
+	key := base64.RawURLEncoding.EncodeToString(make([]byte, 32))
+	cfg, err := parseClientEncryption("mlkem768x25519plus.native.0rtt.pad." + key)
+	if err != nil {
