+++ b/clients/apple/ApplicationLibrary/Views/Abstract/BackButton.swift
@@ -0,0 +1,14 @@
+import Foundation
+import SwiftUI
+
+public struct BackButton: View {
+    @Environment(\.dismiss) private var dismiss
+
+    public var body: some View {
+        Button {
+            dismiss()
