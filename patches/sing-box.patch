+			t.Fatalf("unexpected early result: read=%d err=%v", read, readErr)
+		}
+	}
+	if read, readErr := tracked.Read(buffer[:]); read != 0 || !errors.Is(readErr, io.ErrNoProgress) {
+		t.Fatalf("final result: read=%d err=%v", read, readErr)
+	}
+}
