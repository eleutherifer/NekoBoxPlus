diff --git a/clients/android/app/src/play/java/io/nekohasekai/sfa/vendor/MLKitQRCodeAnalyzer.kt b/clients/android/app/src/play/java/io/nekohasekai/sfa/vendor/MLKitQRCodeAnalyzer.kt
