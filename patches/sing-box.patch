+        headerView?.refresh()
+        setStatusItemHighlighted(true)
+        Task {
+            await loadProfiles()
+        }
+    }
+
+    public func menuDidClose(_: NSMenu) {
+        setStatusItemHighlighted(false)
+    }
+}
