+    if (propsInEnv != null) {
+        val props = Properties()
+        props.load(ByteArrayInputStream(Base64.getDecoder().decode(propsInEnv)))
+        val value = props.getProperty(propName)
+        if (value != null) {
+            return value
+        }
+    }
+    val propsFile = rootProject.file("local.properties")
+    if (propsFile.exists()) {
