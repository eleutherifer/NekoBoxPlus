+
+func (a *dummyAdapter) LoadMASQUEConfig(tag string) *SavedBinary {
+	return nil
+}
+
+func (a *dummyAdapter) SaveMASQUEConfig(tag string, set *SavedBinary) error {
+	return nil
+}
+
+var masqueDummyCache MASQUECacheFile = &dummyAdapter{}
