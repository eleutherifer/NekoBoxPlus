+devices([
+  "iPhone 11 Pro Max",
+  "iPad Pro 13-inch (M4)"
+])
+
+languages([
+  "en-US",
+  "zh-Hans"
+])
+
+project("./sing-box.xcodeproj")
+scheme("SFI")
+app_identifier("io.nekohasekai.sfavt")
