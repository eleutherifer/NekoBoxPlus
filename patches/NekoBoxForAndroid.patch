+            geckoMaxPacketSize = 1400
+            realmServerUrl = "https://realm.example.com"
+            realmId = "realm"
+            realmStunServers = "stun.example.com:3478"
+            realmPortMapping = true
+            realmPortMappingTimeout = "10s"
+            hopIntervalMax = "30s"
+            bbrProfile = "mobile"
+            quicInitialPacketSize = 1350
+        }
