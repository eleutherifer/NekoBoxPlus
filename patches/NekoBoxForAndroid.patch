+        return when (serviceState) {
+            BaseService.State.Connecting,
+            BaseService.State.Connected,
+            BaseService.State.Stopping -> true
+            BaseService.State.Idle,
+            BaseService.State.Stopped -> false
+        }
+    }
+}
