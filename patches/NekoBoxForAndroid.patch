+    onDismissError: () -> Unit,
+) {
+    BackHandler(onBack = onClose)
+    Scaffold(
+        contentWindowInsets = WindowInsets(0, 0, 0, 0),
+        topBar = {
+            TopAppBar(
+                title = { Text(stringResource(R.string.config_settings)) },
