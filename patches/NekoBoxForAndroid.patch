diff --git a/app/src/main/res/layout/layout_profile_appbar.xml b/app/src/main/res/layout/layout_profile_appbar.xml
new file mode 100644
index 0000000000000000000000000000000000000000..57c3d94ed2bcbe9dc2a0d84ab3b921354a38d6bc
--- /dev/null
+++ b/app/src/main/res/layout/layout_profile_appbar.xml
@@ -0,0 +1,97 @@
+<?xml version="1.0" encoding="utf-8"?>
+<com.google.android.material.appbar.AppBarLayout xmlns:android="http://schemas.android.com/apk/res/android"
+    xmlns:app="http://schemas.android.com/apk/res-auto"
+    xmlns:tools="http://schemas.android.com/tools"
+    android:id="@+id/appbar"
+    android:layout_width="match_parent"
+    android:layout_height="?attr/actionBarSize"
+    android:background="?attr/colorSurfaceContainer"
+    android:elevation="0dp"
+    android:minHeight="?attr/actionBarSize"
+    tools:ignore="Overdraw">
+
+    <FrameLayout
+        android:layout_width="match_parent"
+        android:layout_height="wrap_content"
+        android:minHeight="?attr/actionBarSize">
+
+        <com.google.android.material.appbar.MaterialToolbar
+            android:id="@+id/toolbar"
+            android:layout_width="match_parent"
+            android:layout_height="match_parent"
+            android:background="?attr/colorSurfaceContainer"
+            android:theme="?actionBarTheme"
+            android:touchscreenBlocksFocus="false"
+            app:popupTheme="@style/ThemeOverlay.SagerNet.Material3.Menu"
+            app:title="@string/app_name" />
+
+        <LinearLayout
+            android:id="@+id/quick_toolbar"
+            android:layout_width="match_parent"
+            android:layout_height="match_parent"
+            android:background="?attr/colorSurfaceContainer"
+            android:gravity="center_vertical"
+            android:orientation="horizontal"
+            android:visibility="gone">
+
+            <ImageButton
+                android:id="@+id/quick_toolbar_navigation"
+                android:layout_width="56dp"
+                android:layout_height="match_parent"
+                android:background="?attr/selectableItemBackgroundBorderless"
+                android:contentDescription="@string/abc_action_bar_up_description"
+                android:scaleType="center"
+                android:src="@drawable/ic_navigation_menu"
+                app:tint="?attr/colorControlNormal" />
+
+            <HorizontalScrollView
+                android:id="@+id/quick_toolbar_scroll"
+                android:layout_width="0dp"
+                android:layout_height="match_parent"
+                android:layout_weight="1"
+                android:fillViewport="true"
+                android:overScrollMode="never"
+                android:scrollbars="none">
+
+                <LinearLayout
+                    android:id="@+id/quick_toolbar_actions"
+                    android:layout_width="wrap_content"
+                    android:layout_height="match_parent"
+                    android:gravity="center_vertical|end"
+                    android:orientation="horizontal" />
+            </HorizontalScrollView>
+
+            <ImageButton
+                android:id="@+id/quick_toolbar_search"
+                android:layout_width="48dp"
+                android:layout_height="match_parent"
+                android:background="?attr/selectableItemBackgroundBorderless"
+                android:contentDescription="@string/search_menu_title"
+                android:scaleType="center"
+                android:src="@drawable/ic_toolbar_search"
+                app:tint="?attr/colorControlNormal" />
+
+            <ImageButton
+                android:id="@+id/quick_toolbar_add"
+                android:layout_width="48dp"
+                android:layout_height="match_parent"
+                android:background="?attr/selectableItemBackgroundBorderless"
+                android:contentDescription="@string/add_profile"
+                android:scaleType="center"
+                android:src="@drawable/ic_action_note_add"
+                app:tint="?attr/colorControlNormal" />
+
+            <ImageButton
+                android:id="@+id/quick_toolbar_more"
+                android:layout_width="48dp"
+                android:layout_height="match_parent"
+                android:background="?attr/selectableItemBackgroundBorderless"
+                android:contentDescription="@string/toolbar_more_actions"
+                android:scaleType="center"
+                android:src="@drawable/ic_baseline_more_vert_24"
+                app:tint="?attr/colorControlNormal" />
+
+        </LinearLayout>
+
+    </FrameLayout>
+</com.google.android.material.appbar.AppBarLayout>
