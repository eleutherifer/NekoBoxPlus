+
+class PushedEndpointDnsOptionsTest {
+    private val gson = Gson()
+
+    @Test
+    fun serializesOpenVpnAndOpenConnectDnsOptions() {
+        val openVPN = OpenVPNDNSServerOptions().apply {
+            type = "openvpn"
+            tag = "ovpn-dns"
+            endpoint = "ovpn"
+            accept_default_resolvers = true
+            accept_search_domain = true
