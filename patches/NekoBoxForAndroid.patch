+	if shouldRetryProbe(syscall.ENETUNREACH, time.Second, timeout) {
+		t.Fatal("slow network error was retryable")
+	}
+	if shouldRetryProbe(context.Canceled, 100*time.Millisecond, timeout) {
+		t.Fatal("cancellation was retryable")
