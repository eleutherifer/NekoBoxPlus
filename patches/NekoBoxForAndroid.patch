+            _hack_config_map["tag"] = "proxy"
+        }
+
+        assertEquals(null, remoteDnsDetourTag("proxy", listOf(outbound)))
+    }
+
+    @Test
+    fun byedpiProfileRemainsIneligibleForTrafficFragmentation() {
+        val bean = ByeDPIBean().apply { initializeDefaultValues() }
