+func TestRunHardenedTCPPingRetriesConnections(t *testing.T) {
+	var calls atomic.Int32
+	var server net.Conn
+	t.Cleanup(func() {
+		if server != nil {
+			_ = server.Close()
+		}
+	})
+	latency, err := runHardenedTCPPing(
