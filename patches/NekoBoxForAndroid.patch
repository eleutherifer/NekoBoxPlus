+	if !endScope() {
+		t.Fatal("expected cache cleanup after scope")
+	}
+	if v2geoIPCache.entries != nil {
+		t.Fatal("expected cache entries to be cleared")
+	}
+}
+
+func TestGeositeDatCodesAndRules(t *testing.T) {
