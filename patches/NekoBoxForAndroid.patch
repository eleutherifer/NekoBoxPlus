+                onPresetSelected,
+                onCustomServersChanged,
+            )
+            if (isRunning) {
+                Column(verticalArrangement = Arrangement.spacedBy(8.dp)) {
+                    LinearProgressIndicator(modifier = Modifier.fillMaxWidth())
+                    Text(progressText, style = MaterialTheme.typography.bodyMedium)
