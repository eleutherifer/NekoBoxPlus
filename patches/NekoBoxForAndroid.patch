+
+class ProfileCardMarqueeLayoutTest {
+
+    @Test
+    fun composeCardsUseContinuousMarquee() {
+        val source = File(
+            "src/main/java/io/nekohasekai/sagernet/ui/compose/ProfileCard.kt"
