+@Composable
+fun ConfigEditorScreen(
+    initialText: String,
+    showUnsavedDialog: Boolean,
+    onEditorReady: (TextProcessor) -> Unit,
+    onChanged: () -> Unit,
+    onClose: () -> Unit,
+    onApply: () -> Unit,
+    onDiscard: () -> Unit,
+    onDismissUnsavedDialog: () -> Unit,
+    onInsert: (String) -> Unit,
+    onUndo: () -> Unit,
+    onRedo: () -> Unit,
+    onFormat: () -> Unit,
