+		Hostname: "server.example.com",
+		Addresses: []M.Socksaddr{
+			M.ParseSocksaddrHostPort("192.0.2.1", 443),
+		},
+		CustomSNI: "custom.example.com",
+		Username:  "user",
+		Password:  "pass",
