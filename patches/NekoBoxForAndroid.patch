+            if (result != null) {
+                SummaryCard(result, detailsExpanded, onToggleDetails)
+                if (detailsExpanded) Details(result)
+            }
+            Row(modifier = Modifier.fillMaxWidth(), horizontalArrangement = Arrangement.End) {
+                Button(onClick = onAction) {
