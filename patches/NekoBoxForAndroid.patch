+func (r *retryingLocalResolver) Lookup(ctx *ExchangeContext, _, _ string) error {
+	r.access.Lock()
+	r.calls++
+	call := r.calls
+	r.access.Unlock()
+	if call < 3 {
+		ctx.ErrnoCode(int32(syscall.EAGAIN))
+	} else {
+		ctx.Success("192.0.2.30")
+	}
+	return nil
+}
