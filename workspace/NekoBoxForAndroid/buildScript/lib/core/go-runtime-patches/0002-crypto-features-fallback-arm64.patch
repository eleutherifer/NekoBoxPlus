+// Copyright 2026 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+//go:build arm64 && linux
+
+package cpu_test
+
+import (
+	"internal/cpu"
+	"testing"
+)
+
+func TestARM64HWCAPFromCPUInfo(t *testing.T) {
+	tests := []struct {
+		name     string
+		cpuInfo  string
+		expected uint
+	}{
+		{
+			name:     "single CPU",
+			cpuInfo:  "processor : 0\nFeatures : fp asimd aes pmull sha1 sha2 crc32\n",
+			expected: cpu.ARM64HWCAPFP | cpu.ARM64HWCAPASIMD | cpu.ARM64HWCAPAES | cpu.ARM64HWCAPPMULL | cpu.ARM64HWCAPSHA1 | cpu.ARM64HWCAPSHA2 | cpu.ARM64HWCAPCRC32,
+		},
+		{
+			name: "intersection",
+			cpuInfo: "processor : 0\nFeatures : fp asimd aes pmull sha2 crc32\n" +
+				"processor : 1\nFeatures : fp asimd sha2 crc32\n",
+			expected: cpu.ARM64HWCAPFP | cpu.ARM64HWCAPASIMD | cpu.ARM64HWCAPSHA2 | cpu.ARM64HWCAPCRC32,
+		},
+		{
+			name:     "unknown and whitespace",
+			cpuInfo:  "Features\t: fp unknown aes pmull\r\n",
+			expected: cpu.ARM64HWCAPFP | cpu.ARM64HWCAPAES | cpu.ARM64HWCAPPMULL,
+		},
+		{
+			name:     "truncated feature line",
+			cpuInfo:  "processor : 0\nFeatures : fp asimd aes pmull",
+			expected: 0,
+		},
+		{
+			name:     "missing feature line",
+			cpuInfo:  "processor : 0\nCPU implementer : 0x41\n",
+			expected: 0,
+		},
+	}
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			actual := cpu.ARM64HWCAPFromCPUInfo([]byte(test.cpuInfo))
+			if actual != test.expected {
+				t.Fatalf("hwcap = %#x, expected %#x", actual, test.expected)
+			}
+		})
+	}
+}
