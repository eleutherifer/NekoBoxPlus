<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 本地备份部分 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            android:clickable="true"
            android:focusable="true"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/backup_local"
                        android:textAppearance="?attr/textAppearanceHeadline6" />

                    <com.google.android.material.checkbox.MaterialCheckBox
                        android:id="@+id/backup_configurations"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:checked="true"
                        android:text="@string/backup_groups_and_configurations" />

                    <com.google.android.material.checkbox.MaterialCheckBox
                        android:id="@+id/backup_rules"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="@string/backup_rules" />

                    <com.google.android.material.checkbox.MaterialCheckBox
                        android:id="@+id/backup_settings"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="@string/backup_settings" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/backup_summary"
                        android:textAppearance="?attr/textAppearanceBody2"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="20dp"
                    android:layout_marginVertical="8dp"
                    android:orientation="vertical">

                    <!-- 本地备份部分的按钮 -->
                    <Button
                        android:id="@+id/action_share"
                        style="@style/Widget.Material3.Button.SagerNet"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cornerRadius="24dp"
                        android:text="@string/share" />

                    <Button
                        android:id="@+id/action_export"
                        style="@style/Widget.Material3.Button.SagerNet"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cornerRadius="24dp"
                        android:text="@string/action_export_file" />

                    <Button
                        android:id="@+id/action_import_file"
                        style="@style/Widget.Material3.Button.SagerNet"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cornerRadius="24dp"
                        android:text="@string/action_import_file" />

                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- WebDAV 备份部分 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            android:clickable="true"
            android:focusable="true"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/backup_webdav"
                        android:textAppearance="?attr/textAppearanceHeadline6" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="20dp"
                    android:layout_marginVertical="8dp"
                    android:orientation="vertical">

                    <!-- WebDAV 备份部分的按钮 -->
                    <Button
                        android:id="@+id/webdav_settings"
                        style="@style/Widget.Material3.Button.SagerNet"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cornerRadius="24dp"
                        android:text="@string/webdav_settings" />

                    <Button
                        android:id="@+id/backup_to_webdav"
                        style="@style/Widget.Material3.Button.SagerNet"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cornerRadius="24dp"
                        android:text="@string/backup_to_webdav" />

                    <Button
                        android:id="@+id/restore_from_webdav"
                        style="@style/Widget.Material3.Button.SagerNet"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cornerRadius="24dp"
                        android:text="@string/restore_from_webdav" />

                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/git_backup_https"
                    android:textAppearance="?attr/textAppearanceHeadline6" />

                <Button
                    android:id="@+id/git_configure"
                    style="@style/Widget.Material3.Button.SagerNet"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/git_configure"
                    app:cornerRadius="24dp"
                    app:icon="@drawable/ic_action_settings" />

                <Button
                    android:id="@+id/git_backup"
                    style="@style/Widget.Material3.Button.SagerNet"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/git_backup_now"
                    android:visibility="gone"
                    app:cornerRadius="24dp"
                    app:icon="@drawable/ic_baseline_save_24" />

                <Button
                    android:id="@+id/git_restore"
                    style="@style/Widget.Material3.Button.SagerNet"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/git_restore"
                    android:visibility="gone"
                    app:cornerRadius="24dp"
                    app:icon="@drawable/ic_baseline_folder_open_24" />

                <Button
                    android:id="@+id/git_compact"
                    style="@style/Widget.Material3.Button.SagerNet"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/git_compact"
                    android:visibility="gone"
                    app:cornerRadius="24dp"
                    app:icon="@drawable/ic_action_lock" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
